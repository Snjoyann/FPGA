generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coverage_results {
  id                Int       @id @default(autoincrement())
  test_run_id       Int       @unique
  covered_scenarios Int
  total_scenarios   Int
  test_runs         test_runs @relation(fields: [test_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model fpga_metrics {
  id              Int       @id @default(autoincrement())
  test_run_id     Int       @unique
  lut_used        Int
  lut_total       Int
  ff_used         Int
  ff_total        Int
  bram_used       Int
  bram_total      Int
  dsp_used        Int
  dsp_total       Int
  timing_slack_ns Decimal   @db.Decimal(10, 3)
  test_runs       test_runs @relation(fields: [test_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model regression_runs {
  id           Int         @id @default(autoincrement())
  name         String      @unique @db.VarChar(100)
  version      String      @db.VarChar(80)
  branch       String      @default("main") @db.VarChar(100)
  commit_sha   String?     @db.VarChar(40)
  started_at   DateTime    @default(now()) @db.Timestamptz(6)
  completed_at DateTime?   @db.Timestamptz(6)
  created_at   DateTime    @default(now()) @db.Timestamptz(6)
  test_runs    test_runs[]
}

model schema_migrations {
  name       String   @id
  checksum   String
  applied_at DateTime @default(now()) @db.Timestamptz(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model test_runs {
  id                Int               @id @default(autoincrement())
  regression_run_id Int
  test_id           Int
  status            String            @db.VarChar(10)
  duration_ms       Int?
  error_message     String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  coverage_results  coverage_results?
  fpga_metrics      fpga_metrics?
  regression_runs   regression_runs   @relation(fields: [regression_run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tests             tests             @relation(fields: [test_id], references: [id], onUpdate: NoAction)

  @@unique([regression_run_id, test_id])
  @@index([regression_run_id])
  @@index([regression_run_id, test_id], map: "test_runs_regression_test_idx")
  @@index([status])
  @@index([test_id])
}

model tests {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  suite       String      @default("default") @db.VarChar(100)
  description String?
  created_at  DateTime    @default(now()) @db.Timestamptz(6)
  test_runs   test_runs[]
}
