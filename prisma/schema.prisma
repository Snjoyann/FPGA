generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Database check constraints remain enforced by PostgreSQL.
model CoverageResult {
  id               Int     @id @default(autoincrement())
  testRunId        Int     @unique @map("test_run_id")
  coveredScenarios Int     @map("covered_scenarios")
  totalScenarios   Int     @map("total_scenarios")
  testRun          TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("coverage_results")
}

/// Database check constraints remain enforced by PostgreSQL.
model FpgaMetric {
  id            Int     @id @default(autoincrement())
  testRunId     Int     @unique @map("test_run_id")
  lutUsed       Int     @map("lut_used")
  lutTotal      Int     @map("lut_total")
  ffUsed        Int     @map("ff_used")
  ffTotal       Int     @map("ff_total")
  bramUsed      Int     @map("bram_used")
  bramTotal     Int     @map("bram_total")
  dspUsed       Int     @map("dsp_used")
  dspTotal      Int     @map("dsp_total")
  timingSlackNs Decimal @map("timing_slack_ns") @db.Decimal(10, 3)
  testRun       TestRun @relation(fields: [testRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("fpga_metrics")
}

model RegressionRun {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  version     String    @db.VarChar(80)
  branch      String    @default("main") @db.VarChar(100)
  commitSha   String?   @map("commit_sha") @db.VarChar(40)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  testRuns    TestRun[]

  @@map("regression_runs")
}

model SchemaMigration {
  name      String   @id
  checksum  String
  appliedAt DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  @@map("schema_migrations")
}

/// Database check constraints remain enforced by PostgreSQL.
model TestRun {
  id              Int             @id @default(autoincrement())
  regressionRunId Int             @map("regression_run_id")
  testId          Int             @map("test_id")
  status          String          @db.VarChar(10)
  durationMs      Int?            @map("duration_ms")
  errorMessage    String?         @map("error_message")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  coverage        CoverageResult?
  metrics         FpgaMetric?
  regressionRun   RegressionRun   @relation(fields: [regressionRunId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  test            TestDefinition  @relation(fields: [testId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([regressionRunId, testId], map: "test_runs_regression_run_id_test_id_key")
  @@index([regressionRunId], map: "test_runs_regression_run_id_idx")
  @@index([regressionRunId, testId], map: "test_runs_regression_test_idx")
  @@index([status], map: "test_runs_status_idx")
  @@index([testId], map: "test_runs_test_id_idx")
  @@map("test_runs")
}

model TestDefinition {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  suite       String    @default("default") @db.VarChar(100)
  description String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  testRuns    TestRun[]

  @@map("tests")
}
