{
  "name": "fpga-test-system-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "npm run db:check && tsx src/server.ts",
    "dev:db": "npm run db:check && tsx watch src/server.ts",
    "test": "tsx --test src/*.test.ts",
    "test:smoke": "tsx src/smoke-test.ts",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx src/setup-db.ts",
    "db:check": "tsx src/check-db.ts",
    "postinstall": "node -e \"console.log('Dependencies are ready.')\""
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
